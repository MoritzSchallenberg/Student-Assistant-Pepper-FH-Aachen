# Kopieren nach .env und mit echten Werten fuellen:
#   cp .env.example .env
# .env NIEMALS committen (steht in .gitignore).

# --- Pepper / NAOqi ---
PEPPER_PC_IP=192.168.100.1
PEPPER_QI_HOST=192.168.100.50
PEPPER_QI_USER=nao
PEPPER_QI_PASSWORD=changeme
# Entwicklungsauftrag 04-B, AP5B: app.py ist ein manuelles Entwickler-
# werkzeug, das qicli DIREKT anspricht (an Bridge/Aktuator-Arbiter
# vorbei). Bleibt auf "false" gesperrt, ausser fuer einen bewusst
# beaufsichtigten Hardwaretest.
PEPPER_WEB_HARDWARE_TEST_ENABLED=false

# --- Tablet/ADB (optional) ---
ADB_PORT=5555
PHONE_IP=

# --- AnythingLLM ---
ANYTHINGLLM_API_BASE_URL=http://localhost:3001/api/v1
ANYTHINGLLM_API_TOKEN=changeme
ANYTHINGLLM_WORKSPACE=

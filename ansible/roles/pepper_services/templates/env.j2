# {{ ansible_managed }}
# Von systemd per EnvironmentFile geladen (ihk-pepper-*.service).
# NICHT-geheime Laufzeitkonfiguration -- echte Zugangsdaten kommen separat
# ueber eine .env-Datei mit restriktiven Rechten (0600), siehe
# pepper_env_secrets.j2/vault.yml.

ROS_DOMAIN_ID={{ ros_domain_id }}
PEPPER_QI_HOST={{ pepper_qi_host }}
PEPPER_QI_PORT={{ pepper_qi_port }}
PEPPER_QI_USER={{ pepper_qi_user }}
ANYTHINGLLM_API_BASE_URL={{ anythingllm_api_base_url }}
ANYTHINGLLM_WORKSPACE={{ anythingllm_workspace }}
AUDIO_SOURCE_KIND={{ audio_source_kind }}
WHISPER_MODEL={{ whisper_model }}
WHISPER_LANGUAGE={{ whisper_language }}
PEPPER_FAQ_DB_PATH={{ pepper_data_dir }}/faq_cache/faq_cache.sqlite
PEPPER_AUTONOMY_WS={{ pepper_releases_dir }}/current/ros2/autonomy_ws
PEPPER_FLASK_WRAPPER_PATH={{ pepper_releases_dir }}/current/apps/web

# Sicherheitskritische Standardwerte (Auftrag Abschnitt 5/12 -- NIE ohne
# bewusste, beaufsichtigte Entscheidung aendern):
ALLOW_MOTION={{ allow_motion | lower }}
ENABLE_NAVIGATION={{ enable_navigation | lower }}
ENABLE_PERCEPTION={{ enable_perception | lower }}

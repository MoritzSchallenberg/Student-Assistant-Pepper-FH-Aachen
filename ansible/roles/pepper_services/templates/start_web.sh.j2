#!/bin/bash
# {{ ansible_managed }}
# Startskript fuer den Web-/Tablet-Dienst (apps/web). Sourced ROS2 +
# Workspace-Overlay, damit die Tablet-UI-ROS2-Bruecke
# (apps/web/tablet/ros_bridge.py) rclpy findet, siehe
# docs/IMPLEMENTATION_REPORT.md.
#
# WICHTIG: kein "-u" (nounset) -- siehe start_ros2.sh.j2-Kommentar,
# gleiches Problem mit /opt/ros/jazzy/setup.bash.
set -eo pipefail

CURRENT_LINK="{{ pepper_releases_dir }}/current"

if [ ! -e "$CURRENT_LINK" ]; then
  echo "FEHLER: $CURRENT_LINK existiert nicht -- kein Release deployed." >&2
  exit 1
fi

source "{{ ros_setup_bash }}"
source "$CURRENT_LINK/ros2/autonomy_ws/install/setup.bash"

cd "$CURRENT_LINK/apps/web"
exec python3 app.py

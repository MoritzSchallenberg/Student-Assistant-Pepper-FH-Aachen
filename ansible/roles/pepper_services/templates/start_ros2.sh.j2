#!/bin/bash
# {{ ansible_managed }}
# Kontrolliertes Startskript fuer systemd (Auftrag Abschnitt 8):
# systemd kann `source` nicht wie eine interaktive Shell verarbeiten,
# daher dieses Skript mit `exec` am Ende (ersetzt den Skript-Prozess
# durch ros2, damit systemd das richtige PID fuer Restart/Stop kennt).
#
# WICHTIG: kein "-u" (nounset)! /opt/ros/jazzy/setup.bash referenziert
# intern Variablen wie AMENT_TRACE_SETUP_FILES ohne Default-Fallback --
# unter "set -u" bricht das Sourcen sofort mit "ist nicht gesetzt" ab,
# noch bevor irgendetwas Sinnvolles laeuft. Bekannter, haeufiger
# ROS2-Stolperstein beim Kombinieren mit strikten Bash-Optionen. Per
# Live-Test gefunden, siehe GITHUB_DEPLOYMENT_REPORT.md.
set -eo pipefail

CURRENT_LINK="{{ pepper_releases_dir }}/current"

if [ ! -e "$CURRENT_LINK" ]; then
  echo "FEHLER: $CURRENT_LINK existiert nicht -- kein Release deployed." >&2
  exit 1
fi

source "{{ ros_setup_bash }}"
source "$CURRENT_LINK/pepper_autonomy_ws/install/setup.bash"

# Sicherer Abbruch bei fehlender Pepper-Verbindung (Auftrag Abschnitt 8):
# nur eine Warnung, kein Hard-Exit -- der Bringup soll trotzdem starten
# koennen (z.B. fuer Offline-Entwicklung/Tests), aber deutlich sichtbar
# im Journal loggen.
if ! timeout 3 bash -c "echo > /dev/tcp/${PEPPER_QI_HOST}/${PEPPER_QI_PORT}" 2>/dev/null; then
  echo "WARNUNG: Pepper (${PEPPER_QI_HOST}:${PEPPER_QI_PORT}) nicht erreichbar -- Start trotzdem, einzelne Nodes melden das selbst (siehe Journal)." >&2
fi

exec ros2 launch ihk_pepper_bringup full_system.launch.py \
  motion_capable:="${ALLOW_MOTION}" \
  enable_navigation:="${ENABLE_NAVIGATION}" \
  enable_perception:="${ENABLE_PERCEPTION}" \
  audio_source_kind:="${AUDIO_SOURCE_KIND}" \
  pepper_host:="${PEPPER_QI_HOST}" \
  pepper_password:="${PEPPER_QI_PASSWORD}"

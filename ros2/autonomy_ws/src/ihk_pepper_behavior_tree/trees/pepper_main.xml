<?xml version="1.0"?>
<!--
  Pepper Haupt-Verhaltensbaum (Entwicklungsauftrag Abschnitt 39).

  Diese Datei kannst du SOFORT in Groot2 oeffnen (Datei -> Open), auch
  OHNE dass der C++-Ausfuehrungs-Node (bt_executor_node) laeuft — Groot2
  validiert/rendert die Struktur allein anhand des <TreeNodesModel> unten.
  Fuer LIVE-Monitoring (laufende Knoten farbig hervorgehoben) muss
  zusaetzlich bt_executor_node laufen, siehe README.md in diesem Paket —
  das braucht `behaviortree_cpp`, das auf diesem Rechner noch NICHT
  installiert ist (siehe docs/IMPLEMENTATION_REPORT.md).

  Aufbau: root ist ein Fallback (= "versuche der Reihe nach, bis einer
  erfolgreich ist") ueber 6 Subtrees in fester Prioritaet, genau wie im
  Auftrag Abschnitt 39 benannt: Safety > Battery > Interaction >
  Presentation > Navigation > IdleAttract.

  WICHTIG: Die eigentliche Sicherheitsfreigabe (motion_capable,
  SafetyGate) sitzt weiterhin in ihk_pepper_interaction/supervisor_node.py
  — dieser Baum kann sie NICHT umgehen, er liest sie nur (IsSafetyOk-
  Bedingung) und ruft ausschliesslich die bereits existierenden, getesteten
  ROS2-Actions/Services auf (Auftrag 3.4).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Fallback name="PepperTopLevel">
      <SubTree ID="SafetySubtree"/>
      <SubTree ID="BatterySubtree"/>
      <SubTree ID="InteractionSubtree"/>
      <SubTree ID="PresentationSubtree"/>
      <SubTree ID="NavigationSubtree"/>
      <SubTree ID="IdleAttractSubtree"/>
    </Fallback>
  </BehaviorTree>

  <!-- Hoechste Prioritaet: bei Not-Halt/Bumper/Emergency alles stoppen.
       SUCCESS hier blockiert (im Fallback) alle niedriger priorisierten
       Subtrees fuer diesen Tick — genau das ist gewollt. -->
  <BehaviorTree ID="SafetySubtree">
    <Sequence name="Safety">
      <IsSafetyTriggered/>
      <SafeStopAll/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BatterySubtree">
    <Sequence name="Battery">
      <IsBatteryLow threshold="15.0"/>
      <SpeakText text="Mein Akku ist bald leer, ich muss zur Ladestation."/>
    </Sequence>
  </BehaviorTree>

  <!-- Dialog laeuft eigenstaendig/reaktiv in ihk_pepper_dialog
       (dialog_manager_node hoert kontinuierlich auf /audio_node/transcript
       — kein RunDialogue-Action-Server implementiert, siehe README.md).
       Dieser Subtree beobachtet daher nur den Zustand, statt Dialog aktiv
       zu STEUERN — er "gewinnt" im Fallback (SUCCESS), solange ein
       Gespraech laeuft, damit Praesentation/Navigation currently nicht
       gleichzeitig etwas anderes anfangen. -->
  <BehaviorTree ID="InteractionSubtree">
    <IsPersonEngaged/>
  </BehaviorTree>

  <BehaviorTree ID="PresentationSubtree">
    <Sequence name="Presentation">
      <ShouldShowPresentation/>
      <PlayDailyPresentation topic_id="" allow_qa="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Noch nicht funktionsfaehig: kein Node waehlt aktuell eine
       Ziel-Person aus und schreibt sie ins Blackboard (target_track_id).
       IsNavigationTaskActive wird deshalb in der Praxis nie true liefern.
       Struktur ist vorbereitet, siehe README.md "Bekannte Luecken". -->
  <BehaviorTree ID="NavigationSubtree">
    <Sequence name="Navigation">
      <IsNavigationTaskActive/>
      <ApproachTargetPerson track_id="{target_track_id}" target_distance_m="1.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="IdleAttractSubtree">
    <Fallback name="IdleAttract">
      <Sequence name="Attract">
        <IsPersonAttracted/>
        <WaveGesture gesture_name="wave_right"/>
      </Sequence>
      <AlwaysSuccessIdle/>
    </Fallback>
  </BehaviorTree>

  <!-- Knotenmodell: macht die Custom-Knoten oben in Groot2 sichtbar/
       validierbar, auch ohne laufenden bt_executor_node. Ports (Argumente)
       entsprechen 1:1 den Feldern der jeweiligen ROS2-Action/Message,
       siehe ihk_pepper_interfaces. -->
  <TreeNodesModel>
    <Condition ID="IsSafetyTriggered">
      <description>SUCCESS wenn /safety_state.emergency_stop oder .bumper_active true ist.</description>
    </Condition>
    <Action ID="SafeStopAll">
      <description>Ruft /cancel_interaction und den generischen Action-Cancel-Service fuer /play_presentation auf (gleicher Pfad wie der Tablet-Stop-Button).</description>
    </Action>

    <Condition ID="IsBatteryLow">
      <input_port name="threshold" default="15.0">Akku-Prozent-Schwelle</input_port>
    </Condition>
    <Action ID="SpeakText">
      <input_port name="text">Zu sprechender Text (ruft /pepper_bridge/say)</input_port>
    </Action>

    <Condition ID="IsPersonEngaged">
      <description>SUCCESS wenn /interaction_state == ENGAGED (2).</description>
    </Condition>

    <Condition ID="ShouldShowPresentation">
      <description>SUCCESS wenn /interaction_state == IDLE (niemand im Dialog, Zeit fuer das Tagesthema).</description>
    </Condition>
    <Action ID="PlayDailyPresentation">
      <input_port name="topic_id" default="">Leer = automatische Auswahl per Prioritaet/Gueltigkeit</input_port>
      <input_port name="allow_qa" default="true"/>
    </Action>

    <Condition ID="IsNavigationTaskActive">
      <description>SUCCESS wenn /interaction_state == NAVIGATING. Aktuell setzt das noch niemand (siehe README.md).</description>
    </Condition>
    <Action ID="ApproachTargetPerson">
      <input_port name="track_id">Track-ID der Zielperson (aktuell nicht automatisch befuellt, siehe README.md)</input_port>
      <input_port name="target_distance_m" default="1.0"/>
    </Action>

    <Condition ID="IsPersonAttracted">
      <description>SUCCESS wenn /interaction_state == ATTRACT.</description>
    </Condition>
    <Action ID="WaveGesture">
      <input_port name="gesture_name" default="wave_right"/>
    </Action>
    <Action ID="AlwaysSuccessIdle">
      <description>No-op, garantiert dass der Fallback immer etwas "erfolgreich" abschliesst (Pepper bleibt einfach ruhig stehen).</description>
    </Action>
  </TreeNodesModel>

</root>

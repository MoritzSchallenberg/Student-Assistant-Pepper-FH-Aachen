<?xml version="1.0"?>
<!--
  Pepper Haupt-Verhaltensbaum.

  Diese Datei kannst du in Groot2 oeffnen (Datei -> Open), auch OHNE dass
  der C++-Ausfuehrungs-Node (bt_executor_node) laeuft — Groot2
  validiert/rendert die Struktur allein anhand des <TreeNodesModel> unten.
  Fuer LIVE-Monitoring (laufende Knoten farbig hervorgehoben) muss
  zusaetzlich bt_executor_node laufen (localhost:1667), siehe README.md.

  Root ist jetzt ein ReactiveFallback (Entwicklungsauftrag 1, Abschnitt 6)
  statt eines einfachen Fallback – SafetySubtree wird dadurch JEDEN Tick
  neu geprueft, auch waehrend eine niedriger priorisierte Aktion gerade
  RUNNING ist. Loest SafetySubtree in so einem Fall aus, praeempiert
  ReactiveFallback die laufende Aktion (ruft deren onHalted() auf, das
  bei allen StatefulActionNodes die laufende ROS2-Action wirklich
  abbricht) und wechselt zu SafetySubtree.

  Prioritaet: Safety > Battery > PersonInteractionLifecycle > Interaction >
  Presentation > IdleAttract.

  GreetAndApproach steht bewusst VOR Interaction (per E2E-Test in
  Entwicklungsauftrag 1, AP12 gefunden – siehe
  docs/DEVELOPMENT_ORDER_01_REPORT.md): IsPersonEngaged wird bereits
  allein durch einen hohen interest_score wahr (siehe
  interest_scoring.py), OHNE dass je gewinkt/zurueckgewinkt wurde. Stand
  Interaction VOR GreetAndApproach, gewann eine interessierte, aber noch
  nie begruesste Person sofort das Fallback und GreetAndApproachSubtree
  wurde nie getickt. SelectStablePerson gibt bei fehlender Person
  weiterhin sauber FAILURE zurueck (siehe bt_nodes.cpp), das Fallback
  faellt dann normal zu Interaction/Presentation/IdleAttract durch –
  GreetAndApproach "stiehlt" also nur dann Prioritaet, wenn tatsaechlich
  eine Zielperson aktiv verfolgt/begruesst/angefahren wird.

  Entwicklungsauftrag 04-B, AP7, Abschnitt 9/23: GreetAndApproachSubtree
  und DialogueSubtree standen bisher als ZWEI getrennte Eintraege im
  Root-ReactiveFallback – funktional unveraendert, aber jetzt zu EINEM
  benannten PersonInteractionLifecycleSubtree zusammengefasst (siehe
  dort). Eine SubTree-Ebene mehr aendert NICHTS an der Fallback-
  Prioritaet/-Praeemption (verschachtelte Fallbacks verhalten sich
  identisch zu flachen), macht aber den vollstaendigen
  Personeninteraktions-Lebenszyklus (Begruessen -> Annaehern ->
  Ursprungspose sichern -> Gespraech -> Verabschieden -> Zurueckkehren
  -> Aufraeumen) im Baum als EIN Konzept sichtbar, wie vom Auftrag
  verlangt. GreetAndApproachSubtree/DialogueSubtree bleiben dabei
  unveraendert eigenstaendig nutzbar (z.B. fuer gezielte Tests).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="PepperTopLevel">
      <SubTree ID="SafetySubtree"/>
      <SubTree ID="BatterySubtree"/>
      <SubTree ID="PersonInteractionLifecycleSubtree"/>
      <SubTree ID="InteractionSubtree"/>
      <SubTree ID="PresentationSubtree"/>
      <SubTree ID="IdleAttractSubtree"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Entwicklungsauftrag 04-B, AP7, Abschnitt 9/23: fasst
       GreetAndApproachSubtree (Begruessen/Annaehern, inkl. neuem
       CaptureOriginPose vor der Annaeherung) und DialogueSubtree
       (Gespraech, inkl. neuem EndInteractionSubtree danach) unter EINEM
       Namen zusammen – siehe Kommentar am Wurzelbaum oben. Kein
       zweites, paralleles Verwalten derselben Person moeglich: BEIDE
       Zweige lesen/schreiben denselben Blackboard-Eintrag
       target_track_id, und IsConversationInactive/IsConversationReady
       schliessen sich gegenseitig aus (derselbe /interaction_state kann
       nicht gleichzeitig IDLE und CONVERSATION_READY sein). -->
  <BehaviorTree ID="PersonInteractionLifecycleSubtree">
    <ReactiveFallback name="PersonInteractionLifecycle">
      <SubTree ID="GreetAndApproachSubtree"/>
      <SubTree ID="DialogueSubtree"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Hoechste Prioritaet: bei Not-Halt/Bumper/Emergency alles stoppen.
       SUCCESS hier blockiert (im ReactiveFallback) alle niedriger
       priorisierten Subtrees fuer diesen Tick UND praeempiert eine
       gerade laufende Aktion in einem davon — genau das ist gewollt. -->
  <BehaviorTree ID="SafetySubtree">
    <Sequence name="Safety">
      <IsSafetyTriggered/>
      <SafeStopAll/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BatterySubtree">
    <Sequence name="Battery">
      <IsBatteryLow threshold="15.0"/>
      <SpeakText text="Mein Akku ist bald leer, ich muss zur Ladestation."/>
    </Sequence>
  </BehaviorTree>

  <!-- Entwicklungsauftrag 3, AP11: RunDialogue.action ist jetzt ein
       echter Action-Server (run_dialogue_action_server.py), der aktiv
       gestartet wird, sobald CONVERSATION_READY erreicht ist – vorher
       "gewann" im Fallback nur IsPersonEngaged (SUCCESS bei hohem
       interest_score allein), OHNE dass je ein Dialog aktiv angestossen
       wurde (bestaetigte Luecke aus Auftrag 1/2, siehe
       docs/DEVELOPMENT_ORDER_03_REPORT.md AP11). Steht bewusst NACH
       GreetAndApproachSubtree (siehe Kommentar an der Wurzel) – eine
       laufende Begruessung/Annaeherung hat weiterhin Vorrang. Der
       bestehende passive Transkript-Listener-Modus in
       dialog_manager_node.py bleibt fuer dialog_only.launch.py
       erhalten, wird hier aber NICHT gleichzeitig aktiv genutzt. -->
  <BehaviorTree ID="DialogueSubtree">
    <Sequence name="Dialogue">
      <IsConversationReady/>
      <RunDialogueViaBT session_id="{target_track_id}"/>
      <SubTree ID="EndInteractionSubtree"/>
    </Sequence>
  </BehaviorTree>

  <!-- Entwicklungsauftrag 04-B, AP7, Abschnitt 9/12/23: nach einem
       ERFOLGREICH beendeten Gespraech (RunDialogueViaBT == SUCCESS)
       verabschieden, zur Ursprungspose zurueckkehren und die Sitzung
       aufraeumen. Der aeussere Fallback mit AlwaysSuccessIdle als
       letztem Zweig garantiert, dass EndInteractionSubtree IMMER
       SUCCESS liefert – selbst wenn Verabschiedung/Rueckkehr
       fehlschlagen (Sicherheitsereignis, kein gueltiger Ursprung mehr,
       Nav2 nicht erreichbar), werden ClearSelectedPerson/ClearSession/
       SetInteractionState IDLE trotzdem ausgefuehrt. Ohne dieses
       Fangnetz wuerde ein fehlgeschlagenes ReturnToOriginViaBT die
       gesamte Dialogue-Sequence scheitern lassen, waehrend
       /interaction_state auf CONVERSATION_READY stehen bliebe –
       DialogueSubtree wuerde beim naechsten Tick sofort erneut
       RunDialogueViaBT mit derselben, bereits verabschiedeten Person
       versuchen (Auftrag Abschnitt 12: "sicheres Fehlverhalten – nie
       eine Schaetzfahrt/Wiederholung, stattdessen sauber aufraeumen"). -->
  <BehaviorTree ID="EndInteractionSubtree">
    <Fallback name="EndInteractionAlwaysCleansUp">
      <Sequence name="EndInteraction">
        <Fallback name="SayGoodbyeAndReturnOrGiveUp">
          <Sequence name="SayGoodbyeAndReturn">
            <PlayCatalogGesture gesture_name="goodbye_wave" speed_scale="1.0"/>
            <ReturnToOriginViaBT session_id="{origin_session_id}" origin_id="{origin_id}"/>
          </Sequence>
          <AlwaysSuccessIdle/>
        </Fallback>
        <ClearSelectedPerson selected_track_id="{target_track_id}"/>
        <ClearSession origin_id="{origin_id}" origin_session_id="{origin_session_id}"/>
        <SetInteractionState state_name="IDLE"/>
      </Sequence>
      <AlwaysSuccessIdle/>
    </Fallback>
  </BehaviorTree>

  <!-- Faengt weiterhin den Fall ab, dass eine Person allein durch einen
       hohen interest_score als "engagiert" gilt, OHNE dass je
       CONVERSATION_READY erreicht wurde (z.B. waehrend GreetAndApproach
       noch laeuft) – verhindert, dass PresentationSubtree/IdleAttractSubtree
       parallel etwas anderes anfangen. -->
  <BehaviorTree ID="InteractionSubtree">
    <IsPersonEngaged/>
  </BehaviorTree>

  <BehaviorTree ID="PresentationSubtree">
    <Sequence name="Presentation">
      <ShouldShowPresentation/>
      <PlayDailyPresentation topic_id="" allow_qa="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Entwicklungsauftrag 1, Abschnitt 6: der vollstaendige Ablauf
       "stabile Person waehlen -> einmal winken -> auf Rueckwinken
       DERSELBEN track_id warten -> Annaeherung anfragen -> Conversation
       Ready". Sequence (NICHT reaktiv) merkt sich Fortschritt zwischen
       Ticks – kein erneutes Winken/keine erneut gesendete Aktion bei
       jedem Tick, solange ein Schritt noch RUNNING ist.

       Faellt IRGENDEIN Schritt in der inneren Sequence aus (Cooldown
       nicht abgelaufen, Rueckwink-Timeout, Annaeherung nicht erlaubt,
       Annaeherungs-Action schlaegt fehl, Zustandswechsel abgelehnt),
       faengt der aeussere Fallback das ab und raeumt ueber
       ClearSelectedPerson das Blackboard auf (IMMER SUCCESS) – naechster
       Tick beginnt wieder frisch bei SelectStablePerson, kein
       automatischer Wiederanlauf einer bereits abgebrochenen Annaeherung. -->
  <!-- Entwicklungsauftrag 04-B, AP6, Abschnitt 14: das bisherige
       ungefragte Winken zu jeder erkannten stabilen Person (per
       SelectStablePerson) ist ERSETZT durch einen Wakeword-gesteuerten
       Ablauf – SelectStablePerson waehlt hier NICHT mehr selbststaendig
       irgendeine Person, target_track_id kommt stattdessen von
       FindPersonNearSoundRay (audiovisuelle Zuordnung zur gemessenen
       Schallrichtung). Ablauf: Gespraech muss inaktiv sein -> frisches
       Wakeword-Ereignis -> Kopfausrichtung erlaubt (kein Mapping/keine
       Nav2-Fahrt) -> Kopf vorsichtig zur Schallrichtung ausrichten ->
       genau EINE Person in diesem Bereich finden (sonst FAILURE bei
       Mehrdeutigkeit) -> ERST DANACH der bestehende
       Gruss-/Rueckwink-/Annaeherungsablauf, unveraendert. -->
  <BehaviorTree ID="GreetAndApproachSubtree">
    <Sequence name="GreetAndApproach">
      <IsSystemReady max_age_s="3.0"/>
      <IsConversationInactive/>
      <WaitForFreshWakeword max_age_s="2.0"
                             wakeword_event_id="{wakeword_event_id}"
                             azimuth_rad="{wakeword_azimuth_rad}"
                             measured_at_sec="{wakeword_measured_at_sec}"/>
      <IsHeadOrientationAllowed/>
      <OrientHeadToSound wakeword_event_id="{wakeword_event_id}"
                          azimuth_rad="{wakeword_azimuth_rad}"
                          measured_at_sec="{wakeword_measured_at_sec}"
                          max_measurement_age_s="2.0"/>
      <FindPersonNearSoundRay wakeword_event_id="{wakeword_event_id}"
                               azimuth_rad="{wakeword_azimuth_rad}"
                               measured_at_sec="{wakeword_measured_at_sec}"
                               max_measurement_age_s="2.0"
                               target_track_id="{target_track_id}"/>
      <Fallback name="GreetWaveApproachOrCleanup">
        <Sequence name="GreetWaveApproach">
          <HasGreetingCooldownExpired track_id="{target_track_id}" cooldown_s="60.0"/>
          <PlayCatalogGesture gesture_name="wave_right" speed_scale="1.0"/>
          <WaitForGestureFromTrack track_id="{target_track_id}" timeout_s="8.0"/>
          <IsApproachAllowed/>
          <CaptureOriginPose track_id="{target_track_id}"
                              origin_id="{origin_id}"
                              origin_session_id="{origin_session_id}"/>
          <ApproachSelectedPerson track_id="{target_track_id}" target_distance_m="1.0"/>
          <SetInteractionState state_name="CONVERSATION_READY"/>
        </Sequence>
        <ClearSelectedPerson selected_track_id="{target_track_id}"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Entwicklungsauftrag 04-B, AP6, Abschnitt 14: das ungefragte Winken
       hier ist per Default GESPERRT (allow_unsolicited_attract=false) –
       die eigentliche Begruessung laeuft jetzt ueber den Wakeword-
       gesteuerten Ablauf in GreetAndApproachSubtree. Dieser Zweig bleibt
       nur als bewusst deaktivierbare Ausnahme erhalten (z.B. fuer eine
       Messestand-Demo ohne Mikrofon), niemals als Standardverhalten. -->
  <BehaviorTree ID="IdleAttractSubtree">
    <Fallback name="IdleAttract">
      <Sequence name="Attract">
        <IsUnsolicitedAttractAllowed/>
        <IsPersonAttracted/>
        <PlayCatalogGesture gesture_name="wave_right" speed_scale="1.0"/>
      </Sequence>
      <AlwaysSuccessIdle/>
    </Fallback>
  </BehaviorTree>

  <!-- Knotenmodell: macht die Custom-Knoten oben in Groot2 sichtbar/
       validierbar, auch ohne laufenden bt_executor_node. Ports (Argumente)
       entsprechen 1:1 den Feldern der jeweiligen ROS2-Action/Message,
       siehe ihk_pepper_interfaces. -->
  <TreeNodesModel>
    <Condition ID="IsSafetyTriggered">
      <description>SUCCESS wenn /safety_state.emergency_stop oder .bumper_active true ist.</description>
    </Condition>
    <Action ID="SafeStopAll">
      <description>Ruft /cancel_interaction und den generischen Action-Cancel-Service fuer /play_presentation auf (gleicher Pfad wie der Tablet-Stop-Button).</description>
    </Action>

    <Condition ID="IsBatteryLow">
      <input_port name="threshold" default="15.0">Akku-Prozent-Schwelle</input_port>
    </Condition>
    <Action ID="SpeakText">
      <input_port name="text">Zu sprechender Text (ruft /pepper_bridge/say)</input_port>
    </Action>

    <Condition ID="IsPersonEngaged">
      <description>SUCCESS wenn /interaction_state == ENGAGED (2).</description>
    </Condition>

    <Condition ID="ShouldShowPresentation">
      <description>SUCCESS wenn /interaction_state == IDLE (niemand im Dialog, Zeit fuer das Tagesthema).</description>
    </Condition>
    <Action ID="PlayDailyPresentation">
      <input_port name="topic_id" default="">Leer = automatische Auswahl per Prioritaet/Gueltigkeit</input_port>
      <input_port name="allow_qa" default="true"/>
    </Action>

    <Condition ID="IsNavigationTaskActive">
      <description>SUCCESS wenn /interaction_state == NAVIGATING. Aktuell nirgends genutzt (Ersatz durch GreetAndApproachSubtree), Knotentyp bleibt fuer spaetere Verwendung registriert.</description>
    </Condition>

    <Condition ID="IsPersonAttracted">
      <description>SUCCESS wenn /interaction_state == ATTRACT.</description>
    </Condition>
    <Action ID="AlwaysSuccessIdle">
      <description>No-op, garantiert dass der Fallback immer etwas "erfolgreich" abschliesst (Pepper bleibt einfach ruhig stehen).</description>
    </Action>

    <Condition ID="IsSystemReady">
      <input_port name="max_age_s" default="3.0">Maximales Alter der letzten /safety_state-Nachricht</input_port>
      <description>SUCCESS wenn /safety_state aktuell UND weder emergency_stop noch compute_power_invalid.</description>
    </Condition>
    <Condition ID="IsApproachAllowed">
      <description>SUCCESS wenn /safety_state.allow_person_approach true ist.</description>
    </Condition>
    <Action ID="SelectStablePerson">
      <inout_port name="selected_track_id">Blackboard-Feld fuer die gewaehlte Zielperson (kNoSelectedTrackId=-1 wenn keine)</inout_port>
      <input_port name="min_interest_score" default="0.5"/>
      <input_port name="max_track_age_s" default="2.0"/>
      <description>Waehlt/validiert die stabilste Person mit gueltiger 3D-Position; loescht selbst den Blackboard-Eintrag bei Verlust.</description>
    </Action>
    <Condition ID="HasGreetingCooldownExpired">
      <input_port name="track_id"/>
      <input_port name="cooldown_s" default="60.0"/>
    </Condition>
    <Action ID="PlayCatalogGesture">
      <input_port name="gesture_name" default="wave_right"/>
      <input_port name="speed_scale" default="1.0"/>
    </Action>
    <Action ID="WaitForGestureFromTrack">
      <input_port name="track_id"/>
      <input_port name="timeout_s" default="8.0"/>
      <description>RUNNING bis wave_confirmed fuer EXAKT diese track_id oder Timeout (-> FAILURE).</description>
    </Action>
    <Action ID="ApproachSelectedPerson">
      <input_port name="track_id"/>
      <input_port name="target_distance_m" default="1.0"/>
    </Action>
    <Action ID="SetInteractionState">
      <input_port name="state_name">z.B. CONVERSATION_READY – ruft /set_interaction_state (supervisor_node.py entscheidet, ob erlaubt)</input_port>
    </Action>
    <Action ID="ClearSelectedPerson">
      <inout_port name="selected_track_id"/>
    </Action>
    <Condition ID="IsConversationReady">
      <description>SUCCESS wenn /interaction_state == CONVERSATION_READY (7). Entwicklungsauftrag 3, AP11.</description>
    </Condition>
    <Action ID="RunDialogueViaBT">
      <input_port name="session_id">int (Track-ID) -- wird in onStart() zu RunDialogue.action's string-Feld session_id umgewandelt.</input_port>
      <description>Ruft /run_dialogue auf, bricht bei Praeemption (Safety/ReactiveFallback) die laufende Action wirklich ab. Entwicklungsauftrag 3, AP11.</description>
    </Action>

    <!-- Entwicklungsauftrag 04-B, AP7, Abschnitt 9/12: Ursprungspose sichern/zurueckkehren. -->
    <Action ID="CaptureOriginPose">
      <input_port name="track_id"/>
      <output_port name="origin_id"/>
      <output_port name="origin_session_id"/>
      <description>Ruft /capture_origin auf -- sichert die aktuelle Roboterpose im map-Frame als Rueckkehrpunkt, BEVOR sich Pepper einer Person naehert.</description>
    </Action>
    <Action ID="ReturnToOriginViaBT">
      <input_port name="session_id"/>
      <input_port name="origin_id"/>
      <input_port name="max_origin_age_s" default="0.0">0 = Node-seitiger Standardwert</input_port>
      <input_port name="timeout_s" default="0.0">0 = Node-seitiger Standardwert</input_port>
      <description>Ruft /return_to_origin auf -- faehrt zur zuvor per CaptureOriginPose gesicherten Pose zurueck, bricht bei Praeemption wirklich ab.</description>
    </Action>
    <Action ID="ClearSession">
      <inout_port name="origin_id"/>
      <inout_port name="origin_session_id"/>
      <description>Leert die Blackboard-Felder origin_id/origin_session_id, immer SUCCESS.</description>
    </Action>

    <!-- Entwicklungsauftrag 04-B, AP6: Wakeword-gesteuerter Begruessen-Ablauf. -->
    <Condition ID="IsConversationInactive">
      <description>SUCCESS wenn /interaction_state == IDLE (0). Verhindert ein Wakeword-Ereignis waehrend laufender Interaktion.</description>
    </Condition>
    <Action ID="WaitForFreshWakeword">
      <input_port name="max_age_s" default="2.0"/>
      <output_port name="wakeword_event_id"/>
      <output_port name="azimuth_rad"/>
      <output_port name="direction_confidence"/>
      <output_port name="measured_at_sec"/>
      <output_port name="original_stamp_sec"/>
      <output_port name="original_stamp_nanosec"/>
      <description>SUCCESS nur bei einem FRISCHEN, noch nicht verbrauchten WakewordEvent mit gueltiger Richtung, gleichem frame_id wie wakeword_base_frame -- verarbeitet jede event_id GENAU EINMAL (begrenzter Cache, siehe bt_nodes.cpp).</description>
    </Action>
    <Condition ID="IsHeadOrientationAllowed">
      <description>SUCCESS wenn weder Mapping noch Nav2-Fahrt aktiv sind (Kopf bleibt sonst fest, RealSense-Pose beeinflusst SLAM/Hinderniswahrnehmung).</description>
    </Condition>
    <Action ID="OrientHeadToSound">
      <input_port name="wakeword_event_id"/>
      <input_port name="azimuth_rad"/>
      <input_port name="measured_at_sec"/>
      <input_port name="max_measurement_age_s" default="2.0"/>
      <description>Ruft /orient_to_sound auf -- begrenzte, vorsichtige Kopfausrichtung ueber eine HEAD-Lease.</description>
    </Action>
    <Action ID="FindPersonNearSoundRay">
      <input_port name="wakeword_event_id"/>
      <input_port name="azimuth_rad"/>
      <input_port name="measured_at_sec"/>
      <input_port name="max_measurement_age_s" default="2.0"/>
      <output_port name="target_track_id"/>
      <description>Ruft /associate_person_with_sound auf -- FAILURE bei Mehrdeutigkeit/keiner Person, kein target_track_id gesetzt.</description>
    </Action>
    <Condition ID="IsUnsolicitedAttractAllowed">
      <description>SUCCESS nur wenn der Parameter allow_unsolicited_attract explizit auf true gesetzt ist (Standard: false).</description>
    </Condition>
  </TreeNodesModel>

</root>

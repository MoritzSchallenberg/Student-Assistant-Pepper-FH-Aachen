# Entwicklungsauftrag 04-B, AP6, Abschnitt 13: ordnet eine gemessene
# Schallrichtung (bereits nach base_link transformiert) genau EINER
# Person aus den aktuellen RealSense-Personentracks zu -- oder KEINER,
# wenn die Zuordnung mehrdeutig/nicht eindeutig genug ist. Es wird KEINE
# Gesichtserkennung verwendet, um eine mehrdeutige Richtungszuordnung zu
# "erraten" (Auftrag: explizit verboten).

float32 sound_azimuth_rad
builtin_interfaces/Time measured_at
float32 max_measurement_age_s
# Entwicklungsauftrag 04-B, AP6.1, Abschnitt 4/11: dieselbe event_id wie
# WakewordEvent/OrientToSound -- ueber alle Stufen erhalten, damit
# /audio/visual_target (AudioVisualTarget.msg) jedes Ergebnis dem
# ausloesenden Wakeword-Ereignis zuordnen kann. Leer erlaubt (aeltere
# Aufrufer/Tests), aber dann bleibt AudioVisualTarget.event_id ebenfalls leer.
string event_id
---
bool valid
int32 selected_track_id
string reason
float32 angular_error_deg
float32 ambiguity_margin_deg

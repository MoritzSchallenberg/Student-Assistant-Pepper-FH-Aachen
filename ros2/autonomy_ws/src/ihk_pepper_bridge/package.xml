<?xml version="1.0"?>
<package format="3">
  <name>ihk_pepper_bridge</name>
  <version>0.1.0</version>
  <description>Kapselt qicli/SSH-Zugriff auf Pepper als ROS2-Actions/Topics.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <!-- Entwicklungsauftrag 04-B, AP6.1: /joint_states-Publisher fuer
       robot_state_publisher (siehe pepper_robot_state.launch.py). -->
  <depend>sensor_msgs</depend>
  <depend>ihk_pepper_interfaces</depend>
  <!-- Entwicklungsauftrag 04-B, AP5B: Aktuator-Arbiter-Ressourcenableitung
       (resource_derivation.py) -- ihk_pepper_interaction haengt selbst
       NICHT von ihk_pepper_bridge ab, keine zirkulaere Abhaengigkeit. -->
  <depend>ihk_pepper_interaction</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

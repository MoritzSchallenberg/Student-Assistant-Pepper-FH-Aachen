<?xml version="1.0"?>
<package format="3">
  <name>ihk_pepper_dialog</name>
  <version>0.1.0</version>
  <description>Dialogmanager: FAQ-Cache, AnythingLLM-Anbindung, Sitzungsgedaechtnis, TTS-Aufbereitung.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ihk_pepper_interfaces</depend>
  <!-- Entwicklungsauftrag 3, AP10/AP11: run_dialogue_action_server.py
       nutzt cancel_words.py (Stopp-Wort-Erkennung, bereits als Vertrag
       genutzt -- ihk_pepper_audio publiziert das vorverarbeitete Ergebnis
       auf /audio_node/voice_command, hier aber zusaetzlich direkt
       importiert fuer is_hard_stop()) und die ROS-freie
       ihk_pepper_llm_contracts-Pipeline. Keine Rueckabhaengigkeit in die
       andere Richtung -- kein Zirkel. -->
  <depend>ihk_pepper_audio</depend>
  <depend>ihk_pepper_llm_contracts</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

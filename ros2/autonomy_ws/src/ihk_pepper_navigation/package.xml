<?xml version="1.0"?>
<package format="3">
  <name>ihk_pepper_navigation</name>
  <version>0.1.0</version>
  <description>
    RealSense-only Navigation/Mapping (Entwicklungsauftrag 2) + Personen
    anfahren/begleiten/folgen. Der volle Nav2-Stack/robot_localization/
    depthimage_to_laserscan sind auf dem Entwicklungssystem dieser
    Session NICHT installiert (kein sudo-Zugriff) -- siehe
    docs/DEVELOPMENT_ORDER_02_REPORT.md AP13 fuer die exakten
    Install-Befehle. Dieses Paket enthaelt daher: (a) eigenstaendigen,
    getesteten Code ohne Nav2-Abhaengigkeit (Zielpose-Geometrie,
    Diagnose-/Gesundheits-Logik, Zonen-Format, Personen-Ansteuerung mit
    Nav2-ActionClient-Fallback), (b) vorbereitete, teils live gestartete
    (RTAB-Map), teils NICHT getestete (voller Nav2-Stack) Konfigurations-/
    Launch-Dateien fuer den Rest der Kette. robot_localization.yaml/
    slam_mapping.launch.py sind bewusst NICHT mehr Teil des aktiven
    Pfads (ersetzt durch RTAB-Map, siehe deren Datei-Kopfkommentare).
  </description>
  <maintainer email="you@example.com">you</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>ihk_pepper_interfaces</depend>
  <!-- Entwicklungsauftrag 04-B, AP5B: BASE-Lease-Anfragen an den
       zentralen Aktuator-Arbiter (actuator_arbiter.py-Konstanten BASE/
       PRIORITY_NAVIGATION), gleiches Muster wie bereits
       ihk_pepper_bridge/package.xml (Commit 2). -->
  <depend>ihk_pepper_interaction</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>
  <!-- Entwicklungsauftrag 2, AP2: realsense_diagnostics_node dekodiert
       Tiefenbilder fuer die Ungueltig-Anteil-Pruefung, gleiches Muster
       wie ihk_pepper_perception/perception_node.py. Bereits installiert
       (siehe docs/DEVELOPMENT_ORDER_01_REPORT.md). -->
  <depend>cv_bridge</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- NICHT installiert in dieser Session (kein sudo), siehe
       Paketbeschreibung oben und docs/DEVELOPMENT_ORDER_02_REPORT.md
       AP13 fuer die exakten Install-Befehle. Als <exec_depend> statt
       <depend> eingetragen, damit ein rosdep-Lauf sie zwar auflistet,
       ein colcon build dieses Pakets aber nicht daran scheitert, wenn
       sie fehlen. Entwicklungsauftrag 2, AP7: die einzelnen Nav2-Pakete
       aufgelistet, die nav2_bringup.launch.py TATSAECHLICH startet
       (nicht das nav2_bringup-ROS-Paket selbst – gleichnamig, aber
       nicht verwendet). twist_mux entfaellt (Motion Guard uebernimmt
       dessen Rolle, siehe AP8). depthimage_to_laserscan/robot_localization/
       slam_toolbox bleiben als Alternativpfad-Abhaengigkeiten. -->
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- Entwicklungsauftrag 1, Abschnitt 3: RealSense-Bringup + statische
       TF-Kette. realsense2_camera ist auf diesem Entwicklungsrechner
       bereits installiert (siehe docs/DEVELOPMENT_ORDER_01_REPORT.md),
       trotzdem als exec_depend (nicht depend), damit ein colcon build
       dieses Pakets nicht daran haengt, falls es woanders fehlt. -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Entwicklungsauftrag 04-B, AP7, Abschnitt 4: Achsenpruefung
       Kamera-/Mikrofon-Vorwaertsrichtung (sensor_alignment_config.py). -->
  <depend>tf2_geometry_msgs</depend>
  <!-- Entwicklungsauftrag 04-B, AP6.1, Abschnitt 6: dynamische
       base_link->torso->Neck->Head-Kette aus /joint_states (siehe
       pepper_robot_state.launch.py). Das URDF selbst liegt im separaten
       Workspace ros2/robot_model (Paket pepper_description) -- siehe
       Docstring dort fuer die Sourcing-Voraussetzung. -->
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Entwicklungsauftrag 2, AP4/AP5: RGB-D-Odometrie/Mapping/Lokalisierung.
       rtabmap_msgs ist bereits installiert (siehe
       docs/DEVELOPMENT_ORDER_02_REPORT.md), daher <depend> statt
       <exec_depend> – odometry_health_node importiert es direkt.
       rtabmap_odom/rtabmap_slam werden nur per Launch-File gestartet
       (kein Python-Import noetig), bleiben aber als exec_depend
       dokumentiert. -->
  <depend>rtabmap_msgs</depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

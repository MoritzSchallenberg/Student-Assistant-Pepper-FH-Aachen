<?xml version="1.0"?>
<package format="3">
  <name>ihk_pepper_audio</name>
  <version>0.1.0</version>
  <description>Ringpuffer, VAD (Silero, Fallback Energie), Halbduplex, Wakeword, Whisper-Transkription.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ihk_pepper_interfaces</depend>
  <!-- Entwicklungsauftrag 04-B, AP6: InteractionState-Enum fuer die
       zentrale Gespraechszustandsableitung in audio_node.py (Wakeword
       darf nicht mehr allein vom lokalen _session_active-Flag
       abhaengen). -->
  <depend>ihk_pepper_interaction</depend>
  <!-- Entwicklungsauftrag 04-B, AP6.1, Abschnitt 3.1/12:
       sound_direction_transform_node.py transformiert den Schallrichtungs-
       VEKTOR (nicht Punkt) vom respeaker_link- in den base_frame. -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
